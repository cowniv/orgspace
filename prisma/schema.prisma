generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // workshop | talk | hackathon | social
  venue       String
  startsAt    DateTime
  capacity    Int
  createdAt   DateTime @default(now())
  rsvps       Rsvp[]
}

model Rsvp {
  id        String   @id @default(cuid())
